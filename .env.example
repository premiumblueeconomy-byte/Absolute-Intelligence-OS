# Supabase project (create one at supabase.com, then fill these in).
# Client-side (safe to ship — these are the public anon key, not secrets):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (never exposed to the client bundle):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set as a Supabase Edge Function secret (supabase secrets set DEEPSEEK_API_KEY=...),
# NOT here — the reasoning engine runs server-side inside the ask-absolute function.
# DEEPSEEK_API_KEY=
# AIOS_MODEL=deepseek-chat
